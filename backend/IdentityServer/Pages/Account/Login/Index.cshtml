@page "/Account/Login"
@model IdentityServer.Pages.Account.Login.IndexModel
@{
    ViewData["Title"] = "Login";
}

<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Chatbot AI</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-900 min-h-screen flex items-center justify-center">
    <div class="bg-gray-800 p-8 rounded-lg shadow-xl w-full max-w-md">
        <div class="text-center mb-8">
            <h1 class="text-3xl font-bold text-white mb-2">Chatbot AI</h1>
            <p class="text-gray-400">เข้าสู่ระบบเพื่อใช้งาน</p>
        </div>

        <form method="post" asp-route-returnUrl="@Model.ReturnUrl">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-red-400 mb-4 text-sm"></div>

            <div class="mb-4">
                <label for="username" class="block text-gray-300 text-sm font-medium mb-2">
                    ชื่อผู้ใช้หรืออีเมล
                </label>
                <input type="text"
                       asp-for="Input.Username"
                       id="username"
                       class="w-full px-4 py-3 bg-gray-700 border border-gray-600 rounded-lg text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                       placeholder="username@example.com"
                       autofocus />
                <span asp-validation-for="Input.Username" class="text-red-400 text-sm"></span>
            </div>

            <div class="mb-6">
                <label for="password" class="block text-gray-300 text-sm font-medium mb-2">
                    รหัสผ่าน
                </label>
                <input type="password"
                       asp-for="Input.Password"
                       id="password"
                       class="w-full px-4 py-3 bg-gray-700 border border-gray-600 rounded-lg text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                       placeholder="••••••••" />
                <span asp-validation-for="Input.Password" class="text-red-400 text-sm"></span>
            </div>

            <div class="flex items-center justify-between mb-6">
                <label class="flex items-center">
                    <input type="checkbox" asp-for="Input.RememberLogin" class="w-4 h-4 text-blue-500 bg-gray-700 border-gray-600 rounded focus:ring-blue-500" />
                    <span class="ml-2 text-gray-300 text-sm">จดจำการเข้าสู่ระบบ</span>
                </label>
                <a href="/Account/Register" class="text-blue-400 text-sm hover:text-blue-300">
                    สมัครสมาชิก
                </a>
            </div>

            <button type="submit"
                    class="w-full bg-blue-600 hover:bg-blue-700 text-white font-medium py-3 px-4 rounded-lg transition duration-200 ease-in-out transform hover:scale-[1.02]">
                เข้าสู่ระบบ
            </button>
        </form>

        <div class="mt-6 text-center">
            <p class="text-gray-500 text-sm">
                ยังไม่มีบัญชี?
                <a href="/Account/Register?ReturnUrl=@Model.ReturnUrl" class="text-blue-400 hover:text-blue-300">
                    สมัครสมาชิกที่นี่
                </a>
            </p>
        </div>
    </div>
</body>
</html>
