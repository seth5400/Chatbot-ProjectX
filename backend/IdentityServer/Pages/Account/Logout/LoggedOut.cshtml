@page "/Account/Logout/LoggedOut"
@model IdentityServer.Pages.Account.Logout.LoggedOutModel
@{
    ViewData["Title"] = "Logged Out";
}

<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Chatbot AI</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-900 min-h-screen flex items-center justify-center">
    <div class="bg-gray-800 p-8 rounded-lg shadow-xl w-full max-w-md text-center">
        <div class="mb-6">
            <svg class="w-16 h-16 mx-auto text-green-500 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <h1 class="text-2xl font-bold text-white mb-2">ออกจากระบบเรียบร้อยแล้ว</h1>
            <p class="text-gray-400">คุณได้ออกจากระบบเรียบร้อยแล้ว</p>
        </div>

        @if (!string.IsNullOrEmpty(Model.PostLogoutRedirectUri))
        {
            <a href="@Model.PostLogoutRedirectUri"
               class="block w-full bg-blue-600 hover:bg-blue-700 text-white font-medium py-3 px-4 rounded-lg transition duration-200">
                กลับไปยัง @(Model.ClientName ?? "แอปพลิเคชัน")
            </a>
        }
        else
        {
            <a href="/Account/Login"
               class="block w-full bg-blue-600 hover:bg-blue-700 text-white font-medium py-3 px-4 rounded-lg transition duration-200">
                เข้าสู่ระบบอีกครั้ง
            </a>
        }
    </div>
</body>
</html>
