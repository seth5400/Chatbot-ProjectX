@page "/Account/Register"
@model IdentityServer.Pages.Account.Register.IndexModel
@{
    ViewData["Title"] = "Register";
}

<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Chatbot AI</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-900 min-h-screen flex items-center justify-center py-12">
    <div class="bg-gray-800 p-8 rounded-lg shadow-xl w-full max-w-md">
        <div class="text-center mb-8">
            <h1 class="text-3xl font-bold text-white mb-2">สมัครสมาชิก</h1>
            <p class="text-gray-400">สร้างบัญชีใหม่เพื่อใช้งาน Chatbot AI</p>
        </div>

        <form method="post" asp-route-returnUrl="@Model.ReturnUrl">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-red-400 mb-4 text-sm bg-red-900/20 p-3 rounded-lg"></div>

            <div class="mb-4">
                <label for="fullname" class="block text-gray-300 text-sm font-medium mb-2">
                    ชื่อ-นามสกุล
                </label>
                <input type="text"
                       asp-for="Input.FullName"
                       id="fullname"
                       class="w-full px-4 py-3 bg-gray-700 border border-gray-600 rounded-lg text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                       placeholder="สมชาย ใจดี"
                       autofocus />
            </div>

            <div class="mb-4">
                <label for="email" class="block text-gray-300 text-sm font-medium mb-2">
                    อีเมล
                </label>
                <input type="email"
                       asp-for="Input.Email"
                       id="email"
                       class="w-full px-4 py-3 bg-gray-700 border border-gray-600 rounded-lg text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                       placeholder="email@example.com" />
                <span asp-validation-for="Input.Email" class="text-red-400 text-sm"></span>
            </div>

            <div class="mb-4">
                <label for="password" class="block text-gray-300 text-sm font-medium mb-2">
                    รหัสผ่าน
                </label>
                <input type="password"
                       asp-for="Input.Password"
                       id="password"
                       class="w-full px-4 py-3 bg-gray-700 border border-gray-600 rounded-lg text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                       placeholder="••••••••" />
                <span asp-validation-for="Input.Password" class="text-red-400 text-sm"></span>
                <p class="text-gray-500 text-xs mt-1">รหัสผ่านต้องมีอย่างน้อย 6 ตัวอักษร รวมถึงตัวพิมพ์เล็ก ตัวพิมพ์ใหญ่ ตัวเลข และอักขระพิเศษ</p>
            </div>

            <div class="mb-6">
                <label for="confirmPassword" class="block text-gray-300 text-sm font-medium mb-2">
                    ยืนยันรหัสผ่าน
                </label>
                <input type="password"
                       asp-for="Input.ConfirmPassword"
                       id="confirmPassword"
                       class="w-full px-4 py-3 bg-gray-700 border border-gray-600 rounded-lg text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                       placeholder="••••••••" />
                <span asp-validation-for="Input.ConfirmPassword" class="text-red-400 text-sm"></span>
            </div>

            <button type="submit"
                    class="w-full bg-green-600 hover:bg-green-700 text-white font-medium py-3 px-4 rounded-lg transition duration-200 ease-in-out transform hover:scale-[1.02]">
                สมัครสมาชิก
            </button>
        </form>

        <div class="mt-6 text-center">
            <p class="text-gray-500 text-sm">
                มีบัญชีอยู่แล้ว?
                <a href="/Account/Login?ReturnUrl=@Model.ReturnUrl" class="text-blue-400 hover:text-blue-300">
                    เข้าสู่ระบบที่นี่
                </a>
            </p>
        </div>
    </div>
</body>
</html>
